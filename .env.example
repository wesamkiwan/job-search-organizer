# Copy this file to ".env" and adjust the values.
# ".env" is ignored by git: it may contain secrets and must never be committed.

# Development only. In production, generate a long random value, e.g.:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use the local SQLite file (db.sqlite3).
# Example for PostgreSQL: postgres://user:password@localhost:5432/job_search_organizer
# DATABASE_URL=

# Largest document file that can be uploaded, in bytes (default 10 MB = 10485760).
# DOCUMENT_MAX_UPLOAD_SIZE=10485760
